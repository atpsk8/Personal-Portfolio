<%- include('partials/header', { title: 'Home' }) %>

<section class="hero">
    <p class="eyebrow">Full-stack web developer</p>
    <h1 class="typed"><span class="typed-text">Hi, I'm <%= owner.name %>.</span><span class="cursor" aria-hidden="true"></span></h1>
    <p class="lead">I build web apps with JavaScript, React, Node and Express. Here are a few things I've made.</p>
    <div class="hero-actions">
        <a class="btn" href="/portfolio">See my work</a>
        <a class="btn btn-ghost" href="<%= owner.github %>" target="_blank" rel="noopener">GitHub</a>
        <a class="btn btn-ghost" href="/contact">Get in touch</a>
    </div>
</section>

<section class="code-window" aria-label="About me">
    <div class="code-titlebar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="code-filename">about.js</span>
    </div>
    <% const entries = Object.entries(owner.about); %>
    <pre class="code"><code><span class="tok-kw">const</span> <span class="tok-var"><%= owner.name.toLowerCase() %></span> = {
<% entries.forEach(([key, value]) => { -%>
  <span class="tok-key"><%= key %></span>: <% if (Array.isArray(value)) { %>[<% value.forEach((v, i) => { %><%= i ? ', ' : '' %><span class="tok-str">"<%= v %>"</span><% }) %>]<% } else if (typeof value === 'string') { %><span class="tok-str">"<%= value %>"</span><% } else { %><span class="tok-kw"><%= value %></span><% } %>,
<% }) -%>
};</code></pre>
</section>

<section>
    <div class="section-head">
        <h2>Featured projects</h2>
        <a href="/portfolio">All projects &rarr;</a>
    </div>
    <div class="grid">
        <% projects.forEach((project) => { %>
            <%- include('partials/project-card', { project }) %>
        <% }) %>
    </div>
</section>

<%- include('partials/footer') %>
