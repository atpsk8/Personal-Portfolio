        </main>
        <footer class="site-footer status-bar">
            <div class="status-left">
                <span class="status-branch">&#x2387; main</span>
                <span class="status-ok">&#x2713; 0 errors</span>
                <span>&copy; <%= new Date().getFullYear() %> <%= owner.name %></span>
            </div>
            <div class="status-right">
                <span class="status-extra">UTF-8</span>
                <span class="status-extra">Node.js</span>
                <a href="<%= owner.github %>" target="_blank" rel="noopener">GitHub</a>
            </div>
        </footer>
        <script src="/js/main.js" defer></script>
    </body>
</html>
