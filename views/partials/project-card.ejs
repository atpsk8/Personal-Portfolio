<article class="card">
    <h3><%= project.name %></h3>
    <p><%= project.description %></p>
    <ul class="tags">
        <% project.tech.forEach((t) => { %><li><%= t %></li><% }) %>
    </ul>
    <div class="card-links">
        <% if (project.live) { %>
            <a class="btn btn-small" href="<%= project.live %>" target="_blank" rel="noopener">Live site</a>
        <% } %>
        <a class="btn btn-small btn-ghost" href="<%= project.repo %>" target="_blank" rel="noopener">Code</a>
    </div>
</article>
